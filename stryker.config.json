{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts",
    "related": false
  },
  "mutate": ["src/**/*.{ts,tsx}", "!src/main.tsx"],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 85
  }
}
